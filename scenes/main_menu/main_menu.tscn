text = "• WASD หรือปุ่มลูกศร — เดิน   • Shift — วิ่ง
• E — หยิบของ / พาคนในบ้านไปด้วย (มือว่าง 3 ช่อง, คน 1 คน = 2 ช่อง)
• Q — โยนของขึ้นเรือ (ต้องยืนที่ระเบียงข้างเรือ)
• Esc — หยุดเกม / เล่นต่อ

น้ำจะท่วมถึงบ้านใน 60 วินาที วิ่งขนของจำเป็นไปโยนขึ้นเรือ
ของและคนที่อยู่บนเรือเท่านั้นที่จะไปต่อในช่วงเอาชีวิตรอด — ของอยู่คนละที่ทุกครั้งที่เริ่มใหม่"
autowrap_mode = 3

