[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/carry_ui.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_boat.svg" id="2_boat"]

[node name="CarryUI" type="PanelContainer"]
mouse_filter = 2
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Row" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CarryLabel" type="Label" parent="VBox/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(132, 0)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"TitleLabel"
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 24
text = "CARRY 0/3"

[node name="CarrySlots" type="HBoxContainer" parent="VBox/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="DeliveredRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="BoatIcon" type="TextureRect" parent="VBox/DeliveredRow"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
texture = ExtResource("2_boat")
expand_mode = 1
stretch_mode = 5

[node name="DeliveredLabel" type="Label" parent="VBox/DeliveredRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "ส่งขึ้นเรือแล้ว 0 ชิ้น"
