[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/divider.svg" id="2_divider"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 20
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.05, 0.06, 0.62)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "หยุดเกม"
horizontal_alignment = 1

[node name="Divider" type="TextureRect" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
texture = ExtResource("2_divider")
stretch_mode = 3

[node name="ResumeButton" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "ดำเนินการต่อ"

[node name="RestartButton" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "เริ่มใหม่"

[node name="MenuButton" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "กลับหน้าหลัก"

[node name="Help" type="Label" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "WASD / ลูกศร = เดิน   Shift = วิ่ง   E = หยิบของ
Q = โยนของขึ้นเรือ   Esc = หยุดเกม / เล่นต่อ"
horizontal_alignment = 1
autowrap_mode = 3
