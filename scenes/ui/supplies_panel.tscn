[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/supplies_panel.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_boat.svg" id="2_boat"]

[node name="SuppliesPanel" type="PanelContainer"]
custom_minimum_size = Vector2(320, 0)
