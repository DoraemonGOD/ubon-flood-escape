[ext_resource type="Texture2D" path="res://assets/ui/icon_tri_right.svg" id="91_tri_right"]

[node name="Journal" type="PanelContainer"]
theme_type_variation = &"PaperPanel"
script = ExtResource("1_journal")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="DayLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PaperTitle"
text = "วันที่ 1"

[node name="Spacer" type="Control" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="WeatherLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 8
theme_type_variation = &"PaperLabel"
text = "อากาศ: ฝนตกหนัก"

[node name="Tabs" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TabReport" type="Button" parent="VBox/Tabs"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "บันทึก"

[node name="TabRation" type="Button" parent="VBox/Tabs"]
