[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/journal/journal.gd" id="1_journal"]
[ext_resource type="Script" path="res://scripts/ui/journal/report_page.gd" id="2_report"]
[ext_resource type="Script" path="res://scripts/ui/journal/ration_page.gd" id="3_ration"]
