[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/status_bar.gd" id="1_script"]

[node name="StatusBar" type="PanelContainer"]
mouse_filter = 2
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 1

[node name="Title" type="Label" parent="VBox/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 34
text = "THE FIRST NIGHT"

[node name="Subtitle" type="Label" parent="VBox/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 8
theme_override_font_sizes/font_size = 20
text = "คืนแรกกลางสายน้ำ"

[node name="Info" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 18
text = "DAY 1   |   SURVIVORS: 2   |   WEATHER: HEAVY RAIN"
horizontal_alignment = 1
