[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/inventory_bar.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_boat.svg" id="2_bag"]

[node name="InventoryBar" type="PanelContainer"]
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BagIcon" type="TextureRect" parent="VBox/Header"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
texture = ExtResource("2_bag")
expand_mode = 1
stretch_mode = 5

[node name="SlotsLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "ของบนเรือ (0/12 ช่อง)"

[node name="Spacer" type="Control" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Hint" type="Label" parent="VBox/Header"]
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "ชี้เมาส์ที่ช่องเพื่อดูรายละเอียด"

[node name="Slots" type="HBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="Tooltip" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
top_level = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Tooltip"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="TooltipName" type="Label" parent="Tooltip/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 24

[node name="TooltipEn" type="Label" parent="Tooltip/VBox"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
theme_override_font_sizes/font_size = 15

[node name="TooltipDesc" type="Label" parent="Tooltip/VBox"]
