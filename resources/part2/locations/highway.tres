[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/part2/location_data.gd" id="1_loc"]

[resource]
script = ExtResource("1_loc")
id = &"highway"
name_th = "สะพานทางหลวง"
description = "สะพานที่น้ำท่วมไม่ถึง มีเต็นท์ช่วยเหลือและรถทหาร แต่ต้องมีชื่อในบัญชีจึงจะได้อพยพ"
