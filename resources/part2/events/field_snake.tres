[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/part2/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/part2/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://scripts/part2/choice_outcome.gd" id="3_outcome"]

[sub_resource type="Resource" id="Outcome_1"]
script = ExtResource("3_outcome")
id = &"cobra_ok"
weight = 55
journal_lines = Array[String](["กอหญ้าหลุดออกไปพร้อมงู ทุกคนถอนหายใจ"])

[sub_resource type="Resource" id="Outcome_2"]
script = ExtResource("3_outcome")
id = &"cobra_bite"
weight = 45
journal_lines = Array[String](["งูฉก {target} ก่อนจะลงน้ำไป ต้องรีบหายาให้เร็วที่สุด"])
condition_target = 2
condition = 2

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("2_choice")
label = "เขี่ยกอหญ้าออกด้วยไม้พาย"
outcomes = Array[ExtResource("3_outcome")]([SubResource("Outcome_1"), SubResource("Outcome_2")])

[sub_resource type="Resource" id="Outcome_4"]
script = ExtResource("3_outcome")
id = &"cobra_light"
weight = 1
journal_lines = Array[String](["งูตกใจแสงไฟ เลื้อยลงน้ำไปเอง"])

[sub_resource type="Resource" id="Choice_5"]
script = ExtResource("2_choice")
label = "ส่องไฟฉายให้มันตกใจ"
required_item = &"flashlight"
outcomes = Array[ExtResource("3_outcome")]([SubResource("Outcome_4")])

[sub_resource type="Resource" id="Outcome_6"]
script = ExtResource("3_outcome")
id = &"cobra_rope"
weight = 1
journal_lines = Array[String](["เราคล้องเชือกลากกอหญ้าออกไปไกลโดยไม่ต้องเข้าใกล้งู"])

[sub_resource type="Resource" id="Choice_7"]
script = ExtResource("2_choice")
label = "ใช้เชือกคล้องกอหญ้าลากออก"
required_item = &"rope"
outcomes = Array[ExtResource("3_outcome")]([SubResource("Outcome_6")])

[resource]
script = ExtResource("1_event")
id = &"field_snake"
title = "งูเห่าในกอหญ้า"
text = "กอหญ้าลอยน้ำมาติดกราบเรือ ในนั้นมีงูเห่าแผ่แม่เบี้ยอยู่"
choices = Array[ExtResource("2_choice")]([SubResource("Choice_3"), SubResource("Choice_5"), SubResource("Choice_7")])
min_day = 2
max_day = 99
weight = 18
once = true
locations = PackedStringArray("field")
time_of_day = 2
